<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fable bindings to the browser's `ResizeObserver` — the one piece of the DOM the
    `Fable.Browser.*` family does not cover, and the reason this exists rather than being
    another `open Browser.Dom`. Fable-only: `dotnet build` only type-checks it; the runnable
    JS comes from Fable. A standalone project so the bindings are a distinct layer, mirroring
    Fable.Jose and Fable.Keyring — with one difference worth stating, since the name suggests
    otherwise: this binds a browser GLOBAL, not an npm package, so there is nothing to install
    and nothing in package.json to keep it in step with.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ResizeObserver.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Browser.Dom" />
  </ItemGroup>

</Project>
