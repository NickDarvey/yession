<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Session Manager's authority layer: session/container ownership enforcement over
    an injected container backend. The Session Process never references this project —
    it only ever receives the pre-scoped capability record from Yession.Domain.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="State.fs" />
    <Compile Include="SecretsState.fs" />
    <Compile Include="ControlWire.fs" />
    <Compile Include="Authority.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json" />
    <PackageReference Include="Thoth.Json.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Domain\Yession.Domain.fsproj" />
  </ItemGroup>

</Project>
