<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Push.fs" />
    <!-- Depends on nothing but System: retry/backoff as values, used by the client's
         event-feed transport (and available to any other flaky port). -->
    <Compile Include="Resilience.fs" />
    <Compile Include="Identity.fs" />
    <Compile Include="Events.fs" />
    <!-- Terminal output as styled text, and the durable transcript that records it.
         Both depend only on Identity/Events, and neither knows what a session is. -->
    <Compile Include="Ansi.fs" />
    <Compile Include="Transcript.fs" />
    <Compile Include="EventLog.fs" />
    <Compile Include="Sandbox.fs" />
    <!-- Where a terminal's bytes come from (Plan 16, part D). Right after Sandbox.fs
         because it reuses `PtyHandle` rather than minting a parallel handle. -->
    <Compile Include="TerminalSource.fs" />
    <Compile Include="Environment.fs" />
    <Compile Include="Secrets.fs" />
    <Compile Include="Connections.fs" />
    <Compile Include="Authorization.fs" />
    <Compile Include="Notifications.fs" />
    <Compile Include="Mcp.fs" />
    <!-- The agent's tools as data (Plan 16, part A). Depends on nothing but Thoth: a
         descriptor is a name, a schema and a namespace, and knows nothing of sessions. -->
    <Compile Include="Tools.fs" />
    <!-- A stream a provider offers becomes a terminal (Plan 19). After Tools and
         TerminalSource, because it is exactly the join between them. -->
    <Compile Include="ToolStreams.fs" />
    <!-- Which model a turn runs on, as a provider-neutral pair. After Identity.fs (a
         lookup runs on an actor's authority) and before Agent.fs, which carries the
         session's choice into a turn. -->
    <Compile Include="Models.fs" />
    <Compile Include="Conversation.fs" />
    <Compile Include="Repos.fs" />
    <!-- The read half of the imperative session API (Plan 15). Depends on nothing but
         System: a query is a declaration, and what it declares about is somebody else's. -->
    <Compile Include="Queries.fs" />
    <!-- Before SessionState: the synced state carries the approval mode and the subject
         this declares, so the policy types precede the collaborative state that holds
         them. Before Terminals.fs too, because a terminal's mode is one case of it. -->
    <Compile Include="Gates.fs" />
    <Compile Include="Terminals.fs" />
    <Compile Include="TerminalMarks.fs" />
    <!-- After both projections it merges: the chat as a person reads it, said and run
         interleaved by offset (Plan 14). A view-level merge, never a third fold. -->
    <Compile Include="Timeline.fs" />
    <Compile Include="Agent.fs" />
    <!-- The `yession` namespace's registry, built from a turn's capabilities. After
         Agent.fs (it needs them) and after Queries.fs (it generates a tool per query). -->
    <Compile Include="AgentTools.fs" />
    <Compile Include="SessionState.fs" />
    <Compile Include="RichText.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="Transport.fs" />
    <!-- The heartbeat that keeps a link honest: straight after the channel it supervises,
         and after Resilience, whose Sleep port it takes its clock from. -->
    <Compile Include="Link.fs" />
    <Compile Include="Launch.fs" />
    <Compile Include="PublicAccess.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Serialization.fs" />
    <Compile Include="Sync.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json" />
    <PackageReference Include="Thoth.Json.Net" />
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="FSharp.Data.Adaptive" />
    <PackageReference Include="Fable.Yjs" />
    <PackageReference Include="Ylmish" />
  </ItemGroup>

</Project>
