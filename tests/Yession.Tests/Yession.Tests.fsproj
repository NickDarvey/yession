<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single test project for the repo. F# compiled by Fable to JS and run on Node;
    `dotnet build` only type-checks it. Pyxpecto (Expecto-style) is the one test runner.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exe so the CLR target is runnable: `dotnet run` executes the real-browser E2E
         (Browser.fs) through the Microsoft.Playwright driver. Fable ignores OutputType. -->
    <OutputType>Exe</OutputType>
    <!-- Pyxpecto pulls Fable.Python transitively (pinned to an older Fable.Core). We only
         compile to JS, so the version skew is irrelevant. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tags.fs" />
    <Compile Include="Version.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Reaper.fs" />
    <Compile Include="Secrets.fs" />
    <Compile Include="SessionProcess.fs" />
    <Compile Include="Support.fs" />
    <Compile Include="Connections.fs" />
    <Compile Include="Queries.fs" />
    <Compile Include="WorkSandboxes.fs" />
    <Compile Include="CommandGates.fs" />
    <Compile Include="Tools.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="OtlpStub.fs" />
    <Compile Include="Sync.fs" />
    <Compile Include="Terminals.fs" />
    <Compile Include="Attach.fs" />
    <Compile Include="Timeline.fs" />
    <Compile Include="Editor.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Telemetry.fs" />
    <Compile Include="TelemetryE2E.fs" />
    <Compile Include="Browser.fs" />
    <Compile Include="E2E.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Phase2.fs" />
    <Compile Include="DockerIntegration.fs" />
    <Compile Include="SrtIntegration.fs" />
    <Compile Include="GitIntegration.fs" />
    <Compile Include="PtyIntegration.fs" />
    <Compile Include="Phase3.fs" />
    <Compile Include="EventsHttp.fs" />
    <Compile Include="Resilience.fs" />
    <Compile Include="Oidc.fs" />
    <Compile Include="Phase4.fs" />
    <Compile Include="Hedgehog.fs" />
    <Compile Include="Properties.fs" />
    <Compile Include="Acceptance.fs" />
    <Compile Include="InMemory.fs" />
    <Compile Include="NixSource.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Pyxpecto" />
    <!-- CLR-only: drives the real-browser E2E (Browser.fs). Fable never sees it (that code
         is #if-compiled out under Fable), so it does not need Fable bindings. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Ylmish" />
    <PackageReference Include="Fable.Yjs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fable.OpenTelemetry\Fable.OpenTelemetry.fsproj" />
    <ProjectReference Include="..\..\src\Yession.Domain\Yession.Domain.fsproj" />
    <ProjectReference Include="..\..\src\Yession.Manager\Yession.Manager.fsproj" />
    <ProjectReference Include="..\..\src\Yession.SessionProcess\Yession.SessionProcess.fsproj" />
    <ProjectReference Include="..\..\src\Yession.App\Yession.App.fsproj" />
    <ProjectReference Include="..\..\app\Yession.Host.fsproj" />
  </ItemGroup>

</Project>
