<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end WebRTC test. Fable-compiled to JS and run on Node by `mise run test`. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="E2E.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\Yession.Host.fsproj" />
  </ItemGroup>

</Project>
