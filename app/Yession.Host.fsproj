<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Session Process host library: F# compiled to JavaScript by Fable and run on Node.
    Fable-only (never executed as .NET); `dotnet build` only type-checks it. The runnable
    artifacts come from `fable` via the Main / E2E projects and the mise tasks.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Version.fs" />
    <Compile Include="Interop.fs" />
    <Compile Include="Assets.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="Sse.fs" />
    <Compile Include="WebRtc.fs" />
    <Compile Include="Ssr.fs" />
    <Compile Include="SessionAuth.fs" />
    <Compile Include="Signalling.fs" />
    <Compile Include="Telemetry.fs" />
    <Compile Include="EventStore.fs" />
    <Compile Include="DocStore.fs" />
    <Compile Include="TranscriptStore.fs" />
    <Compile Include="Emulator.fs" />
    <Compile Include="Fs.fs" />
    <Compile Include="Sandboxes.fs" />
    <!-- Attaching a terminal to somebody else's byte stream (Plan 16, part D). Beside the
         sandbox adapters because it is the same kind of thing: a way to get a PtyHandle. -->
    <Compile Include="AttachWs.fs" />
    <!-- The query registry (Plan 15). Before every capability that declares a query, and
         after Sse/SessionAuth, which are the only things its route needs. -->
    <Compile Include="Queries.fs" />
    <Compile Include="Repos.fs" />
    <!-- Reading `yession.yaml` off a checkout (Plan 27). After Repos.fs, which owns where a
         checkout is, and Fs.fs. The only part of the file's story that cannot run in the
         cheap tier: the decoder itself is pure and lives in the domain. -->
    <Compile Include="OperatorResources.fs" />
    <Compile Include="RepoConfig.fs" />
    <!-- The session's named WorkSandboxes (Plan 15, stage 2). After Queries (it declares
         one) and Sandboxes (it composes them); before Host, which wires terminals to it. -->
    <Compile Include="WorkSandboxes.fs" />
    <!-- The `shell_profile` query (Plan 25). Beside the other two registrations, and before
         Commands, which invalidates it. -->
    <Compile Include="ShellProfile.fs" />
    <!-- The gated commands (Plan 14, Plan 15): both halves of each — what a turn calls and
         what the gate calls once a verdict is in — beside each other, and out of the entry
         module where no test could reach them. After the services they run against. -->
    <Compile Include="Commands.fs" />
    <!-- The fold over every checkout's `yession.yaml` (Plan 27). After Commands.fs, because
         a declaration becomes one of ITS calls and the encoding of that call is private to
         it — there is no second way to ask for a sandbox. -->
    <Compile Include="RepoSandboxes.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="ManagerStore.fs" />
    <Compile Include="SecretsCipher.fs" />
    <Compile Include="KeyStore.fs" />
    <Compile Include="SecretStore.fs" />
    <Compile Include="Broker.fs" />
    <Compile Include="NotificationHub.fs" />
    <Compile Include="RetainedHub.fs" />
    <!-- Per-session retained broadcast (Plan 17): what a session's MCP server SET rides.
         Beside the other two hubs because it is the third shape of the same idea. -->
    <Compile Include="KeyedRetainedHub.fs" />
    <Compile Include="ManagerOidc.fs" />
    <Compile Include="Control.fs" />
    <Compile Include="ControlClient.fs" />
    <!-- The session as an MCP client (Plan 17, step 3). After Sse.fs (it reuses the frame
         parser) and after Version.fs (its clientInfo says which build is asking). -->
    <Compile Include="McpClient.fs" />
    <Compile Include="ClaudeConnection.fs" />
    <!-- The provider-neutral `/models` route. After ClaudeConnection.fs only by
         convention — it references nothing in it, which is the property worth keeping. -->
    <Compile Include="ModelRoutes.fs" />
    <Compile Include="GitHubConnection.fs" />
    <Compile Include="Spawn.fs" />
    <Compile Include="ProcessManager.fs" />
    <Compile Include="ManagerUi.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Manager.fs" />
    <Compile Include="SessionMain.fs" />
    <!-- The provider's entry. Last, like the other two: an entry has top-level effects, and
         nothing may depend on one. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Lit" />
    <PackageReference Include="Fable.Node" />
    <PackageReference Include="Fable.Yjs" />
    <PackageReference Include="Ylmish" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Fable.Dockerode\Fable.Dockerode.fsproj" />
    <ProjectReference Include="..\src\Fable.Jose\Fable.Jose.fsproj" />
    <ProjectReference Include="..\src\Fable.Keyring\Fable.Keyring.fsproj" />
    <ProjectReference Include="..\src\Fable.OpenIdClient\Fable.OpenIdClient.fsproj" />
    <ProjectReference Include="..\src\Fable.OpenTelemetry\Fable.OpenTelemetry.fsproj" />
    <ProjectReference Include="..\src\Yession.Domain\Yession.Domain.fsproj" />
    <ProjectReference Include="..\src\Yession.Manager\Yession.Manager.fsproj" />
    <ProjectReference Include="..\src\Yession.Oidc\Yession.Oidc.fsproj" />
    <ProjectReference Include="..\src\Yession.SessionProcess\Yession.SessionProcess.fsproj" />
    <ProjectReference Include="..\src\Yession.App\Yession.App.fsproj" />
  </ItemGroup>

</Project>
