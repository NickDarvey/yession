<Project Sdk="Microsoft.NET.Sdk">

  <!-- Entry point for `mise run start`. Fable-compiled to JS and run on Node. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Host.fsproj" />
  </ItemGroup>

</Project>
