<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The browser client entry: Fable-compiled to app/out/browser, then bundled by esbuild
    into app/out/public/client.js, which the Session Process serves at /client.js.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Browser.fs" />
    <!-- Host-free harness for the rich-editor browser E2E; bundled only by the test build,
         never imported by the app entry (Browser.fs), so it does not ship. -->
    <Compile Include="EditorHarness.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Fable.Lit" />
    <PackageReference Include="Ylmish" />
    <PackageReference Include="Fable.Yjs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yession.Domain\Yession.Domain.fsproj" />
    <ProjectReference Include="..\..\src\Yession.App\Yession.App.fsproj" />
  </ItemGroup>

</Project>
