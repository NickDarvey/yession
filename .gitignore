# Node — no trailing slash: under devenv, node_modules is a symlink to the Nix-built tree,
# and a dir-only pattern (`node_modules/`) would not match a symlink.
node_modules
npm-debug.log*

# .NET / Fable
bin/
obj/
.fable/
fable_modules/
*.user

# Build output
dist/
build/

# Fable output (compiled JS in out/ dirs and any emitted next to F# sources).
# Hand-written .mjs (e.g. test runners) are kept.
app/out/
tests/**/out/
app/**/*.js
src/**/*.js
tests/**/*.js
# Examples build the same way, into their own tree. `dist/` above is anchored to the repo
# root, so an example's bundle needs naming here too.
examples/**/out/
examples/**/dist/
examples/**/*.js

# Python examples: uv builds the environment from the committed lock, and pytest and the
# interpreter leave their caches beside it.
.venv/
__pycache__/
.pytest_cache/

# Local env / secrets
.env
.env.local

# OS / editor
.DS_Store

# Nix
result
result-*
.direnv/

# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix
# Generated in github-restricted sandboxes (points the devenv input at the
# cache-substituted source); never committed.
devenv.local.yaml
# devenv.lock IS committed, for its nixpkgs node: `channels.nixos.org/nixos-unstable` is a
# moving target, so an unlocked CI run resolved whatever it pointed at that minute — two jobs
# in one pull request could build against different nixpkgs, and our cachix missed every time.
# The committed lock carries nixpkgs ONLY. devenv's own input is left out on purpose: its rev
# comes from the devenv CLI, and in a github-restricted sandbox devenv.local.yaml replaces that
# input with a store path — neither is a fact about this repository. devenv re-adds that node
# after any run, so `.claude/setup.sh` installs a local clean filter that strips it from what
# git hashes, and the tree stays clean.
#
# The filter is convenience, not the guard: it is per clone and arrives when setup runs.
# `tests/Yession.Tests/LockSource.fs` is what refuses the content, and says why at length.

# Browser E2E scratch data
tests/browser/.data*

# Local Session Process runtime data (event logs, doc store)
.yession/

# Release packaging output
dist/
