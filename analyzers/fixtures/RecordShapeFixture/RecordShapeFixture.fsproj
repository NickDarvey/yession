<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a product project and deliberately not in Yession.slnx, for the same reason the
    other fixtures are not: half the records below are meant to be reported. `lint`
    analyzes it on its own and checks the verdicts against the `// YES004` markers in the
    source.

    It references nothing, so its population is itself — which is also what makes it a
    fixture for the population rule rather than only the field-set one: a collision
    entirely inside somebody else's assembly is not this project's to report, and there is
    no somebody else here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Shapes.fs" />
  </ItemGroup>

</Project>
