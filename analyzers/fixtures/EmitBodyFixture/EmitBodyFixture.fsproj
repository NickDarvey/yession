<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a product project and deliberately not in Yession.slnx, for the same reason the
    other fixtures are not: every macro below is there to be judged, and half of them are
    meant to fail. `lint` analyzes it on its own and checks the verdicts against the
    `// YES003` markers in the source.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bodies.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
