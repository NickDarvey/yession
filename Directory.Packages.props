<Project>
  <!--
    NuGet Central Package Management: pin every package version here once,
    repo-wide. F# projects (added from delivery step 00 onward) reference
    packages by name only; versions are governed centrally.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ylmish: the Elmish <-> Yjs sync boundary (Fable + FSharp.Data.Adaptive). -->
    <PackageVersion Include="Ylmish" Version="1.0.0-beta0218" />
    <!-- Yjs bindings used at the sync boundary (same release train as Ylmish). -->
    <PackageVersion Include="Fable.Yjs" Version="1.0.0-beta0218" />
    <!-- The Elmish loop Ylmish binds to (version Ylmish is built against). -->
    <PackageVersion Include="Fable.Elmish" Version="4.2.0" />
    <!-- Incremental values driving Ylmish's encode direction (version Ylmish is built against). -->
    <PackageVersion Include="FSharp.Data.Adaptive" Version="1.2.26" />
    <!-- Fable interop core (Node host + browser client). 5.2 adds `Compiler.isDotnet` &c.,
         the compile-time runtime discriminator the unified test harness uses. -->
    <PackageVersion Include="Fable.Core" Version="5.2.0" />
    <!-- Fable.Lit: the `html` DSL for the client shell (client-side render) and the
         management UI (our own SSR wrapper renders the same templates to a string). -->
    <PackageVersion Include="Fable.Lit" Version="1.4.2" />
    <!-- Maintained Node core-module bindings (type-only; no npm dependency). -->
    <PackageVersion Include="Fable.Node" Version="1.6.0" />
    <!-- Single test framework: Expecto-style tests compiled by Fable and run on Node. -->
    <PackageVersion Include="Fable.Pyxpecto" Version="2.0.0" />
    <!-- JSON wire-format codec for the domain (isomorphic: Fable + .NET). The Fable
         build uses Thoth.Json; the .NET build uses the Thoth.Json.Net backend. -->
    <PackageVersion Include="Thoth.Json" Version="10.5.1" />
    <PackageVersion Include="Thoth.Json.Net" Version="12.0.0" />
    <!-- Real-browser E2E driver (CLR-only; the test project's .NET run uses it). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <!-- Test stack (versions taken from the dotnet xunit template for net10.0). -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
