<Project>

  <!--
    Warnings are errors, repo-wide.

    The reason is F#'s exhaustiveness checking (FS0025). A shared contract expressed as a
    discriminated union — a route set, a config shape, a protocol frame — only holds if
    adding a case forces every consumer to account for it. As a warning that guarantee is
    advisory: the build stays green and the unhandled case becomes a runtime
    `MatchFailureException` in whichever deployment happens to hit it first. As an error the
    compiler is the gate, which is the whole point of declaring the contract as a type.

    Applies to `dotnet build Yession.slnx` (the type-check gate in `tasks.fsx compile`).
    Fable's own compilation is separate and unaffected.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU1900 is "could not FETCH vulnerability data", not "a vulnerability" — the
      finding codes (NU1901-NU1904) stay errors. As an error it made every build
      behind srt's authenticating proxy fail in restore: NuGet's client cannot
      authenticate to that proxy even where curl can, so a sandboxed `check` died
      before compiling anything, saying only that a service index would not load.
      A build that cannot check is worth a warning; only a build that checked and
      FOUND something is worth stopping.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
